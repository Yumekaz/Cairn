[Unit]
Description=Disposable Cairn acceptance VM runtime
After=network.target

[Service]
Group=ubuntu
RuntimeDirectory=cairn-proof
RuntimeDirectoryMode=0750
Environment=PYTHONPATH=/opt/cairn-stack/Mini-Docker
WorkingDirectory=/opt/cairn-stack/Mini-Docker
ExecStart=/opt/cairn-stack/Mini-Docker/venv/bin/python -m mini_docker daemon --socket /run/cairn-proof/mini-docker.sock --socket-mode 660
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
