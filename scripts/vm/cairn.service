[Unit]
Description=Disposable Cairn acceptance VM control plane
After=cairn-proof-runtime.service
Requires=cairn-proof-runtime.service

[Service]
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=CAIRN_ROOTFS=/opt/cairn-stack/Mini-Docker/rootfs
WorkingDirectory=/opt/cairn-stack/SERVER
ExecStart=/home/ubuntu/.local/bin/cairnd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
